{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "presets": [],

  "logo": {
    "source": "~/.config/fastfetch/images/1.png",
    "type": "kitty",
    "height": 24,
    "padding": { "top": 1 }
  },

  "display": {
    "separator": " ➜ "
  },

  "modules": [
    "break", "break",

    /* ========================= */
    /* == SYSTEM & OS BLOCK  == */
    /* ========================= */

    {
      "type": "os",
      "key": " ┌  ",
      "keyColor": "31"
    },
    {
      "type": "kernel",
      "key": " ├  ",
      "keyColor": "31"
    },
    {
      "type": "command",
      "key": " ├ 󰥔 ",
      "keyColor": "31",
      "text": "birth_install=$(stat -c %W /); current=$(date +%s); echo $(((current - birth_install) / 86400)) days"
    },
    {
      "type": "uptime",
      "key": " ├ 󰥔 ",
      "keyColor": "31"
    },
    {
      "type": "packages",
      "format": "{} (nix)",
      "key": " ├ 󰏖 ",
      "keyColor": "31"
    },
    {
      "type": "shell",
      "key": " └  ",
      "keyColor": "31"
    },

    "break",

    /* ========================= */
    /* == WINDOW MANAGER UI  == */
    /* ========================= */

    {
      "type": "custom",
      "key": " ┌ 󰕮 ",
      "format": "XMonad ➜ btw 🐧",
      "keyColor": "32"
    },
    {
      "type": "wmtheme",
      "key": " ├ 󰉼 ",
      "keyColor": "32"
    },
    {
      "type": "icons",
      "key": " ├ 󰀻 ",
      "keyColor": "32"
    },
    {
      "type": "cursor",
      "key": " ├ 󰆿 ",
      "keyColor": "32"
    },
    {
      "type": "terminal",
      "key": " ├  ",
      "keyColor": "32"
    },
    {
      "type": "terminalfont",
      "key": " └  ",
      "keyColor": "32"
    },

    "break",

    /* ========================= */
    /* == HARDWARE BLOCK     == */
    /* ========================= */

    {
      "type": "host",
      "format": "{5} {1} Type {2}",
      "key": " ┌ 󰍹 ",
      "keyColor": "33"
    },
    {
      "type": "cpu",
      "format": "{1} ({3}) @ {7} GHz",
      "key": " ├ 󰍛 ",
      "keyColor": "33"
    },
    {
      "type": "gpu",
      "format": "{1} {2} @ {12} GHz",
      "key": " ├ 󰢮 ",
      "keyColor": "33"
    },
    {
      "type": "memory",
      "key": " ├ 󰘚 ",
      "keyColor": "33"
    },
    {
      "type": "swap",
      "key": " ├ 󰓡 ",
      "keyColor": "33"
    },

    "break",

    /* ========================= */
    /* == STORAGE / GAMING   == */
    /* ========================= */

    {
      "type": "command",
      "key": " ┌ 󰋊 ",
      "keyColor": "35",
      "text": "df -h / | awk 'NR==2 {print \"Root → \" $3 \" / \" $2 \" (\" $5 \")\"}'"
    },
    {
      "type": "command",
      "key": " ├ 󰋊 ",
      "keyColor": "35",
      "text": "df -h /mnt/cthulhu-lab | awk 'NR==2 {print \"Cthulhu lab → \" $3 \" / \" $2 \" (\" $5 \")\"}'"
    },
    {
      "type": "command",
      "key": " ├ 🎮",
      "keyColor": "35",
      "text": "df -h /mnt/games-vol1 | awk 'NR==2 {print \"Games vol.1 → \" $3 \" / \" $2 \" (\" $5 \")\"}'"
    },
    {
      "type": "command",
      "key": " └ 🎮",
      "keyColor": "35",
      "text": "df -h /mnt/games-vol2 | awk 'NR==2 {print \"Games vol.2 → \" $3 \" / \" $2 \" (\" $5 \")\"}'"
    },

    "break", "break",

    /* ========================= */
    /* == COLORS BLOCK       == */
    /* ========================= */

    {
      "type": "colors",
      "symbol": "circle",
      "padding": { "top": 1 }
    }
  ]
}
